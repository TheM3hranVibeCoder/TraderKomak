# ── TraderKomak environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit the real file. NEVER put OANDA_API_TOKEN into any VITE_* var.

# ── OANDA (server-side ONLY — market-server / deployment secrets) ────────
# Practice vs live URLs differ; practice example below.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# ── Binance (public market data — no API key) ────────────────────────────
# Defaults work in unrestricted regions. If Binance is geo-blocked on your
# network (HTTP 451 / connection refused), point these at a reachable
# mirror or your own reverse proxy (e.g. a Cloudflare Worker / VPS nginx):
#   BINANCE_API_URL=https://your-binance-proxy.example.com
#   BINANCE_STREAM_URL=wss://your-binance-ws-proxy.example.com
BINANCE_API_URL=https://api.binance.com
BINANCE_STREAM_URL=wss://stream.binance.com:9443

# ── cTrader (US30 index CFD — server-side ONLY) ──────────────────────────
# Optional: without these the server runs exactly as before and US30 charts
# show an upstream error. Full step-by-step: deploy/ctrader-setup.md
# 1) Register an app at https://openapi.ctrader.com → Client ID + Secret
# 2) Generate an OAuth token for your DEMO account (guide has the URL)
# 3) Paste the tokens here — the server refreshes them automatically and
#    discovers the numeric account id from the token (logged at boot).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Optional but recommended: the numeric ctidTraderAccountId. Leave empty and
# the server discovers it from the token on first connect (also written to
# DATA_DIR/ctrader-token.json) — copy it into VITE_CTRADER_ACCOUNT_ID below.
CTRADER_ACCOUNT_ID=
# Paste the accessToken AND refreshToken from the OAuth token page. Either
# one is enough to start (a refresh token alone mints the access token).
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Demo vs live endpoints (default = demo, recommended for market data).
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
# Override ONLY if your broker names the Dow symbol differently
# ("US30.cash", "USA30", "DJI30"…). Empty = auto-detect.
CTRADER_US30_SYMBOL=

# ── Market server ────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Comma-separated list of origins allowed by CORS ("*" for local dev only)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Optional hardening: shared secret between the edge Worker
# (cloudflare-worker/edge, `wrangler secret put EDGE_SHARED_SECRET`) and this
# server. Requests carrying the matching X-Tk-Edge-Auth header are attributed
# to the Worker-attested client IP outright. Empty = structural IP rules only.
EDGE_SHARED_SECRET=
# Instruments kept aggregated (and buffered) even with zero subscribers,
# comma separated. This is how 1s history accumulates before anyone watches.
PERSISTENT_AGGREGATIONS=EUR_USD:5s

# ── Frontend (browser-safe; ONLY VITE_* values reach the browser) ────────
# WebSocket endpoint of the market server.
VITE_MARKET_WS_URL=ws://localhost:8080/ws
# HTTP base for historical candles. Empty string = same origin
# (Vite dev proxy in development, Netlify function proxy in production).
VITE_API_HTTP_URL=

# ── Direct candle sources (browser → provider, skipping the market server)
# Binance public endpoints are the built-in defaults; the overrides exist
# for regional mirrors. If Binance geo-blocks the visitor (HTTP 451 / reset),
# the browser falls back to the market server automatically — Binance blocks
# datacenter IPs, so a Cloudflare-Worker relay is NOT an option (verified).
# VITE_BINANCE_PROXY_URL only helps if you host the relay somewhere Binance
# tolerates (e.g. a VPS nginx reverse proxy).
VITE_BINANCE_REST_URL=https://data-api.binance.vision
VITE_BINANCE_WS_URL=wss://data-stream.binance.vision
VITE_BINANCE_PROXY_URL=
# OANDA candles/prices via the oanda-proxy worker (cloudflare-worker/oanda).
# The OANDA token lives in the WORKER SECRETS — never in a VITE_* var.
# Leave empty to keep serving OANDA from the market server.
VITE_OANDA_PROXY_URL=
# Economic news (ForexFactory calendar) via the same worker's /news route —
# edge-cached, so news survives a market-server/VPS outage. Defaults to
# VITE_OANDA_PROXY_URL when empty; set a dedicated URL only if you split the
# news proxy onto its own worker.
VITE_NEWS_PROXY_URL=
# cTrader browser-direct (US30): the visitor's own internet carries all US30
# candles/ticks straight from cTrader's JSON WebSocket gateway — zero
# market-server bandwidth, same model as Binance/OANDA. The demo app
# credentials go here (they are REQUIRED by cTrader's per-connection
# handshake; market-data-only, no trading scope). The fresh ACCESS TOKEN is
# NOT set here — the server /api/ctrader-session serves the auto-refreshed
# one. VITE_CTRADER_ACCESS_TOKEN is only a static fallback for deployments
# without the server config (expires ~30 days — replace by hand).
# Copy Client ID/Secret from the same Open API app as the server section,
# and the account id once the server discovers it (boot log /
# DATA_DIR/ctrader-token.json).
VITE_CTRADER_CLIENT_ID=
VITE_CTRADER_CLIENT_SECRET=
VITE_CTRADER_ACCOUNT_ID=
VITE_CTRADER_ACCESS_TOKEN=
# Overrides for the JSON WebSocket gateway (defaults match the demo env).
VITE_CTRADER_WS_HOST=demo.ctraderapi.com
VITE_CTRADER_WS_PORT=5036

# ── Netlify function proxy (server-side secret config on Netlify) ────────
# Public base URL of the deployed market server. The Netlify function uses
# this to forward short-lived /api/candles requests.
MARKET_SERVER_URL=
CHAT_ADMIN_KEY=

# ── Supabase (Google login, cloud sync, admin) ─────────────────────────
# Project URL + anon key from Supabase → Settings → API (anon key is public).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
