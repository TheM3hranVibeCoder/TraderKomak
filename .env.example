# ── TraderKomak environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit the real file. NEVER put OANDA_API_TOKEN into any VITE_* var.

# ── OANDA (server-side ONLY — market-server / deployment secrets) ────────
# Practice vs live URLs differ; practice example below.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=101-001-12588109-002
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# ── Binance (public market data — no API key) ────────────────────────────
# Defaults work in unrestricted regions. If Binance is geo-blocked on your
# network (HTTP 451 / connection refused), point these at a reachable
# mirror or your own reverse proxy (e.g. a Cloudflare Worker / VPS nginx):
#   BINANCE_API_URL=https://your-binance-proxy.example.com
#   BINANCE_STREAM_URL=wss://your-binance-ws-proxy.example.com
BINANCE_API_URL=https://api.binance.com
BINANCE_STREAM_URL=wss://stream.binance.com:9443

# ── Market server ────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Comma-separated list of origins allowed by CORS ("*" for local dev only)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Instruments kept aggregated (and buffered) even with zero subscribers,
# comma separated. This is how 1s history accumulates before anyone watches.
PERSISTENT_AGGREGATIONS=EUR_USD:1s

# ── Frontend (browser-safe; ONLY VITE_* values reach the browser) ────────
# WebSocket endpoint of the market server.
VITE_MARKET_WS_URL=ws://localhost:8080/ws
# HTTP base for historical candles. Empty string = same origin
# (Vite dev proxy in development, Netlify function proxy in production).
VITE_API_HTTP_URL=

# ── Netlify function proxy (server-side secret config on Netlify) ────────
# Public base URL of the deployed market server. The Netlify function uses
# this to forward short-lived /api/candles requests.
MARKET_SERVER_URL=
