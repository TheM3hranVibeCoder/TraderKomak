{
  "name": "@traderkomak/market-server",
  "version": "0.1.0",
  "private": true,
  "description": "TraderKomak persistent market-data service: OANDA stream, candle aggregation, WebSocket hub",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
